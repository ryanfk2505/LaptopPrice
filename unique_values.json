# Jalankan ini di Colab untuk update kurs
import json

# Kurs update (sesuaikan dengan kurs terbaru)
exchange_rates = {
    'INR': 1,
    'IDR': 191.5,    # 1 INR = 191.5 IDR (perkiraan)
    'USD': 0.012,    # 1 INR = 0.012 USD
    'EUR': 0.011,    # 1 INR = 0.011 EUR
    'GBP': 0.0095,
    'JPY': 1.85,
    'SGD': 0.016,
    'MYR': 0.056
}

# Load file
with open('deployment_files/unique_values.json', 'r') as f:
    data = json.load(f)

# Tambahkan kurs
data['exchange_rates'] = exchange_rates
data['currencies'] = ['INR', 'IDR', 'USD', 'EUR', 'GBP', 'JPY', 'SGD', 'MYR']

# Simpan
with open('deployment_files/unique_values.json', 'w') as f:
    json.dump(data, f, indent=2)

print("✅ Kurs mata uang ditambahkan!")
